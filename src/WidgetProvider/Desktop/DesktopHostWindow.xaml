<Window x:Class="CustomWidgets.WidgetProvider.Desktop.DesktopHostWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Eigene Widgets"
        Width="820"
        Height="300"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Opacity="0"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <SolidColorBrush x:Key="CardBrush" Color="#E61B1B1B" />
        <SolidColorBrush x:Key="CardBorderBrush" Color="#33FFFFFF" />
        <SolidColorBrush x:Key="PrimaryTextBrush" Color="#F7FFFFFF" />
        <SolidColorBrush x:Key="SecondaryTextBrush" Color="#A8FFFFFF" />
        <SolidColorBrush x:Key="TertiaryTextBrush" Color="#72FFFFFF" />
        <SolidColorBrush x:Key="AccentBrush" Color="#FF4CC2FF" />
        <SolidColorBrush x:Key="AccentSoftBrush" Color="#334CC2FF" />
        <SolidColorBrush x:Key="ButtonBrush" Color="#1AFFFFFF" />
        <SolidColorBrush x:Key="ButtonHoverBrush" Color="#33FFFFFF" />
        <SolidColorBrush x:Key="ButtonPressedBrush" Color="#4DFFFFFF" />

        <Style x:Key="IconButton" TargetType="{x:Type Button}">
            <Setter Property="Width" Value="38" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Margin" Value="3,0" />
            <Setter Property="Background" Value="{StaticResource ButtonBrush}" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                CornerRadius="19">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource ButtonHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource ButtonPressedBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.3" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PlayButton" TargetType="{x:Type Button}" BasedOn="{StaticResource IconButton}">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="46" />
            <Setter Property="Margin" Value="6,0" />
            <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                CornerRadius="23">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#4D4CC2FF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#704CC2FF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.3" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="VolumeSliderStyle" TargetType="{x:Type Slider}">
            <Setter Property="Height" Value="24" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Slider}">
                        <Grid Height="24" Background="Transparent">
                            <Border Height="4"
                                    CornerRadius="2"
                                    Background="#33FFFFFF"
                                    VerticalAlignment="Center" />
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.DecreaseLarge}"
                                                  Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="{x:Type RepeatButton}">
                                                <Border Height="4"
                                                        CornerRadius="2"
                                                        Background="{StaticResource AccentBrush}"
                                                        VerticalAlignment="Center" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.IncreaseLarge}"
                                                  Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="{x:Type RepeatButton}">
                                                <Border Height="4" Background="Transparent" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="12" Height="12">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="{x:Type Thumb}">
                                                <Ellipse Width="12"
                                                         Height="12"
                                                         Fill="{StaticResource AccentBrush}" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SmallIconButton" TargetType="{x:Type Button}" BasedOn="{StaticResource IconButton}">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0" />
        </Style>

        <Style x:Key="SectionLabel" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
        </Style>

        <Style x:Key="StatValue" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="27" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="StatLabel" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
            <Setter Property="Margin" Value="0,1,0,5" />
        </Style>

        <Style x:Key="StatDetail" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Foreground" Value="{StaticResource TertiaryTextBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="MetricBar" TargetType="{x:Type ProgressBar}">
            <Setter Property="Height" Value="4" />
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Maximum" Value="100" />
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
            <Setter Property="Background" Value="#22FFFFFF" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Margin" Value="0,0,0,5" />
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.15*" />
            <ColumnDefinition Width="14" />
            <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="{StaticResource CardBrush}"
                BorderBrush="{StaticResource CardBorderBrush}"
                BorderThickness="1"
                CornerRadius="18"
                Padding="18,16"
                Cursor="SizeAll"
                MouseLeftButtonDown="OnCardMouseLeftButtonDown">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="&#xE8D6;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="13"
                                   Foreground="{StaticResource AccentBrush}"
                                   Margin="0,0,7,0" />
                        <TextBlock Text="JETZT LÄUFT"
                                   Style="{StaticResource SectionLabel}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <TextBlock x:Name="PlaybackStatusText"
                                   FontSize="10"
                                   Foreground="{StaticResource TertiaryTextBrush}" />
                        <TextBlock Text="⠿"
                                   FontFamily="Segoe UI Symbol"
                                   FontSize="14"
                                   Foreground="{StaticResource TertiaryTextBrush}"
                                   Margin="9,0,0,0"
                                   VerticalAlignment="Center"
                                   ToolTip="Ziehen, um die Widgets zu verschieben" />
                    </StackPanel>
                </Grid>

                <Grid x:Name="MediaLinkArea"
                      Grid.Row="1"
                      Margin="0,12,0,10"
                      Background="Transparent"
                      Cursor="SizeAll"
                      MouseEnter="OnMediaLinkMouseEnter"
                      MouseLeave="OnMediaLinkMouseLeave">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border x:Name="MediaLinkHighlight"
                            Background="Transparent"
                            CornerRadius="12"
                            Margin="-8,-6"
                            Panel.ZIndex="-1" />

                    <Grid Width="96" Height="96" Margin="0,0,15,0">
                        <Border CornerRadius="12" Background="#22FFFFFF" />
                        <Border CornerRadius="12">
                            <Border.Background>
                                <ImageBrush x:Name="CoverBrush" Stretch="UniformToFill" />
                            </Border.Background>
                        </Border>
                        <TextBlock x:Name="CoverPlaceholder"
                                   Text="♪"
                                   FontFamily="Segoe UI Symbol"
                                   FontSize="36"
                                   Foreground="{StaticResource TertiaryTextBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Grid>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="TitleText"
                                   Text="Keine Wiedergabe"
                                   FontSize="19"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource PrimaryTextBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   TextWrapping="NoWrap" />
                        <TextBlock x:Name="ArtistText"
                                   Text="Starten Sie einen Player."
                                   FontSize="13"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   Margin="0,3,0,0"
                                   TextTrimming="CharacterEllipsis"
                                   TextWrapping="NoWrap" />
                        <TextBlock x:Name="AlbumText"
                                   FontSize="11"
                                   Foreground="{StaticResource TertiaryTextBrush}"
                                   Margin="0,2,0,0"
                                   TextTrimming="CharacterEllipsis"
                                   TextWrapping="NoWrap"
                                   Visibility="Collapsed" />
                        <TextBlock x:Name="MediaMessageText"
                                   FontSize="11"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   Margin="0,5,0,0"
                                   TextWrapping="Wrap"
                                   Visibility="Collapsed" />
                    </StackPanel>
                </Grid>

                <StackPanel Grid.Row="2" HorizontalAlignment="Center">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button x:Name="PreviousButton"
                            Style="{StaticResource IconButton}"
                            Content="&#xE892;"
                            ToolTip="Vorheriger Titel"
                            Click="OnPreviousClick" />
                    <Button x:Name="PlayPauseButton"
                            Style="{StaticResource PlayButton}"
                            Content="&#xE769;"
                            ToolTip="Wiedergabe pausieren"
                            Click="OnPlayPauseClick" />
                    <Button x:Name="NextButton"
                            Style="{StaticResource IconButton}"
                            Content="&#xE893;"
                            ToolTip="Nächster Titel"
                            Click="OnNextClick" />

                    <Border Width="1" Background="#22FFFFFF" Margin="10,7" />

                    <Button x:Name="MuteButton"
                            Style="{StaticResource IconButton}"
                            Content="&#xE74F;"
                            ToolTip="Stummschalten"
                            Click="OnMuteClick" />
                    <Slider x:Name="VolumeSlider"
                            Style="{StaticResource VolumeSliderStyle}"
                            Width="86"
                            Margin="8,0,0,0"
                            VerticalAlignment="Center"
                            Minimum="0"
                            Maximum="100"
                            Value="50"
                            SmallChange="1"
                            LargeChange="10"
                            IsMoveToPointEnabled="True"
                            Focusable="False"
                            ToolTip="Lautstärke"
                            ValueChanged="OnVolumeSliderValueChanged" />
                    <TextBlock x:Name="VolumeValueText"
                               Text="–"
                               MinWidth="30"
                               Margin="6,0,0,0"
                               TextAlignment="Right"
                               VerticalAlignment="Center"
                               FontSize="10"
                               Foreground="{StaticResource TertiaryTextBrush}" />
                    <TextBlock x:Name="VolumeMutedText"
                               Text="Stumm"
                               Margin="4,0,0,0"
                               VerticalAlignment="Center"
                               FontSize="9"
                               Foreground="{StaticResource AccentBrush}"
                               Visibility="Collapsed" />
                    </StackPanel>
                    <TextBlock x:Name="AudioDeviceText"
                               Text="Ausgabe: …"
                               Margin="0,3,0,0"
                               HorizontalAlignment="Center"
                               MaxWidth="300"
                               TextAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               FontSize="10"
                               Foreground="{StaticResource SecondaryTextBrush}" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Column="2"
                Background="{StaticResource CardBrush}"
                BorderBrush="{StaticResource CardBorderBrush}"
                BorderThickness="1"
                CornerRadius="18"
                Padding="18,16"
                Cursor="SizeAll"
                MouseLeftButtonDown="OnCardMouseLeftButtonDown">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="&#xE7F4;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="13"
                                   Foreground="{StaticResource AccentBrush}"
                                   Margin="0,0,7,0" />
                        <TextBlock Text="SYSTEM"
                                   Style="{StaticResource SectionLabel}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <TextBlock Text="⠿"
                                   FontFamily="Segoe UI Symbol"
                                   FontSize="14"
                                   Foreground="{StaticResource TertiaryTextBrush}"
                                   Margin="0,0,8,0"
                                   VerticalAlignment="Center"
                                   ToolTip="Ziehen, um die Widgets zu verschieben" />
                        <Button x:Name="RefreshButton"
                                Style="{StaticResource SmallIconButton}"
                                Content="&#xE72C;"
                                ToolTip="Systemwerte aktualisieren"
                                Click="OnRefreshClick" />
                    </StackPanel>
                </Grid>

                <UniformGrid Grid.Row="1" Columns="3" Margin="0,18,0,8">
                    <StackPanel Margin="0,0,10,0">
                        <TextBlock x:Name="CpuValue" Text="–" Style="{StaticResource StatValue}" />
                        <TextBlock Text="CPU" Style="{StaticResource StatLabel}" />
                        <ProgressBar x:Name="CpuBar" Style="{StaticResource MetricBar}" Value="0" />
                        <TextBlock x:Name="CpuDetail" Style="{StaticResource StatDetail}" />
                    </StackPanel>
                    <StackPanel Margin="0,0,10,0">
                        <TextBlock x:Name="RamValue" Text="–" Style="{StaticResource StatValue}" />
                        <TextBlock Text="RAM" Style="{StaticResource StatLabel}" />
                        <ProgressBar x:Name="RamBar" Style="{StaticResource MetricBar}" Value="0" />
                        <TextBlock x:Name="RamDetail" Style="{StaticResource StatDetail}" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock x:Name="BatteryValue" Text="–" Style="{StaticResource StatValue}" />
                        <TextBlock Text="AKKU" Style="{StaticResource StatLabel}" />
                        <ProgressBar x:Name="BatteryBar" Style="{StaticResource MetricBar}" Value="0" />
                        <TextBlock x:Name="BatteryDetail" Style="{StaticResource StatDetail}" />
                    </StackPanel>
                </UniformGrid>

                <TextBlock x:Name="UpdatedText"
                           Grid.Row="2"
                           Text="Aktualisiere …"
                           FontSize="10"
                           Foreground="{StaticResource TertiaryTextBrush}" />
            </Grid>
        </Border>
    </Grid>
</Window>
